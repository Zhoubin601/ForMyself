<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/todo_row_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/todo_row_check" android:layout_width="40dp" android:layout_height="32dp" android:padding="10dp" android:src="@drawable/todo_unchecked" android:scaleType="fitCenter" android:contentDescription="完成或撤销任务" />
    <TextView android:id="@+id/todo_row_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:paddingStart="2dp" android:paddingEnd="4dp" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/todo_row_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B6C6C0" android:textSize="10sp" />
</LinearLayout>
