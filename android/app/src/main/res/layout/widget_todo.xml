<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/todo_widget_background" android:clipToOutline="true">
    <LinearLayout android:id="@+id/todo_widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:id="@+id/todo_widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="6dp" android:background="@drawable/todo_widget_header_background" android:contentDescription="打开每日待办">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/todo_widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F5F7F8" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:includeFontPadding="false" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TODAY" android:textColor="#8F9A9F" android:textSize="8sp" android:letterSpacing="0.08" android:paddingTop="3dp" android:includeFontPadding="false" />
            </LinearLayout>
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="2dp">
                <ImageView android:id="@+id/todo_widget_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="完成进度" />
                <TextView android:id="@+id/todo_widget_count" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#E6F9F5" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:text="0/0" />
            </FrameLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/todo_widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="4dp">
            <ListView android:id="@+id/todo_widget_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="#12D9E2E4" android:dividerHeight="0.5dp" android:scrollbars="vertical" />
            <TextView android:id="@+id/todo_widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#AAB6BB" android:textSize="12sp" android:text="今天还没有安排，点击添加" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
