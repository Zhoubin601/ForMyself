<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/debug_network_security_config">
        <activity
            android:name="com.yubin.formyself.KanataM6BridgeActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name="com.yubin.formyself.KanataM6RotationActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar" />

        <provider
            android:name="com.yubin.formyself.KanataM6SyntheticSafProvider"
            android:authorities="com.yubin.formyself.m2qa.saf"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name="com.yubin.formyself.KanataM6KillableWorkerService"
            android:exported="false"
            android:process=":m6worker" />
    </application>
</manifest>
