<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/debug_network_security_config">
        <activity
            android:name="com.yubin.formyself.KanataM6BridgeActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name="com.yubin.formyself.KanataM6RotationActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name="com.yubin.formyself.KanataM6ShareReceiverActivity"
            android:exported="true"
            android:label="Kanata Share Test Receiver"
            android:process=":m6sharerecv"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-kanata-kpb1" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.yubin.formyself.KanataM6SyntheticSafProvider"
            android:authorities="com.yubin.formyself.m2qa.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name="com.yubin.formyself.KanataM6KillableWorkerService"
            android:exported="false"
            android:process=":m6worker" />
    </application>
</manifest>
